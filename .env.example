# Copy to .env and uncomment what you need. Everything is optional.
# The container fills in safe defaults for the rest.

# true opens sign-ups, false closes them. Default: true.
# REGISTRATION_OPEN=true

# Cloud storage per account, in MB. Default: 500.
# STORAGE_LIMIT_MB=500

# Leave empty to generate one in the /data volume on first start.
# If you set it, use base64 of 32 random bytes and never change it.
# MFA_ENCRYPTION_KEY=

# Set by scripts/make-owner.mjs --local. Leave empty unless you know the account id.
# OWNER_ACCOUNT_ID=
